&НаСервере
Процедура УстановитьОтборПоПроектуСервер()
	
	Проект = ПараметрыСеанса.ТекущийПроект;
	УстановитьПараметрыВыбораСпискаВерсийИсправленияСпискаОшибок(Проект);
	УстановитьПараметрыВыбораСпискаРелизныхВетокСпискаОшибокВВетках(Проект);
	
	Проекты.УстановитьОтборВСпискеПоПроекту(Список, Проект);
	Проекты.УстановитьОтборВСпискеПоПроекту(СписокОшибокВВетках, Проект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	Если Элементы.Найти("СписокКонтекстноеМенюПризнатьИсправитьПроверитьЗакрыть") <> Неопределено Тогда
		Элементы.СписокКонтекстноеМенюПризнатьИсправитьПроверитьЗакрыть.Видимость = ДоступноИзменениеОшибок;
	КонецЕсли;
	
	Если Элементы.Найти("СписокКонтекстноеМенюНеПризнаватьОтозватьЗакрыть") <> Неопределено Тогда
		Элементы.СписокКонтекстноеМенюНеПризнаватьОтозватьЗакрыть.Видимость = ДоступноИзменениеОшибок;
	КонецЕсли;

	Если Элементы.Найти("СписокКонтекстноеМенюНеПланируетсяИсправлять") <> Неопределено Тогда
		Элементы.СписокКонтекстноеМенюНеПланируетсяИсправлять.Видимость = ДоступноПланированиеОтработки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьУказанияОднойВеткиИсправления()
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() < 0 Тогда
		Возврат Неопределено; 
	КонецЕсли;
	ВеткиВКоторыхТребуетсяИсправление = Новый Массив;
	Ошибки = Новый Массив;

	Для Каждого Строка из Элементы.Список.ВыделенныеСтроки Цикл
		Если Строка.Исправляется 
			= ПредопределенноеЗначение("Перечисление.ВариантыИсправленияОшибок.ВРазныхВетках") Тогда
			Для Каждого СтрокаИсправлениеВВетках Из Строка.ИсправлениеВВетках Цикл
				Если СтрокаИсправлениеВВетках.СостояниеИсправления = Перечисления.СостоянияИсправленияОшибок.ТребуетсяИсправление 
					И НЕ ЗначениеЗаполнено(СтрокаИсправлениеВВетках.ВеткаИсправления) Тогда
					Если ВеткиВКоторыхТребуетсяИсправление.Найти(СтрокаИсправлениеВВетках.Ветка) = Неопределено Тогда
						ВеткиВКоторыхТребуетсяИсправление.Добавить(СтрокаИсправлениеВВетках.Ветка);
					КонецЕсли;
					Если Ошибки.Найти(Строка) = Неопределено Тогда
						Ошибки.Добавить(Строка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если ВеткиВКоторыхТребуетсяИсправление.Количество() > 1 Тогда
		СтрокаСоСпискомВеток = СтрСоединить(ВеткиВКоторыхТребуетсяИсправление, "; ");
		ТекстСообщения = СтрШаблон(НСтр("ru='Нельзя указать одну ветку для исправления, в выделенных ошибках требуется исправление в нескольких ветках: %1.'"), 
								   СтрокаСоСпискомВеток);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;

	Если Ошибки.Количество() = 0 ИЛИ ВеткиВКоторыхТребуетсяИсправление.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Не найдено ни одной ошибки, где требуется указать ветку исправления (ветки уже заполнены или указано, что исправление не требуется).'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Ветка = ВеткиВКоторыхТребуетсяИсправление[0];
	Результат = Новый Структура("Ошибки, Ветка, Владелец", Ошибки, Ветка, Ветка.Владелец);
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура УказатьВеткуИсправленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Ветки") Тогда
		КоличествоУспешных = 0;
		УказатьВеткуИсправленияСервер(ДополнительныеПараметры.Ошибки, Результат, КоличествоУспешных);
		
		ТекстОповещения = НСтр("ru='""%Ветка%"" указана у ошибок: %Количество%'");
		ТекстОповещения = СтрЗаменить(ТекстОповещения, "%Количество%", КоличествоУспешных);
		ТекстОповещения = СтрЗаменить(ТекстОповещения, "%Ветка%", Результат);
		ПоказатьОповещениеПользователя(НСтр("ru='Заполнение ветки исправления'"),,ТекстОповещения, БиблиотекаКартинок.Информация32);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УказатьВеткуИсправленияСервер(Ошибки, Ветка, КоличествоУспешных)
	
	Для Каждого Ошибка Из Ошибки Цикл
		Попытка
			ОшибкаОбъект = Ошибка.ПолучитьОбъект();
			Для Каждого СтрокаИсправлениеВВетках Из ОшибкаОбъект.ИсправлениеВВетках Цикл
				Если СтрокаИсправлениеВВетках.СостояниеИсправления = Перечисления.СостоянияИсправленияОшибок.ТребуетсяИсправление 
					
					И НЕ ЗначениеЗаполнено(СтрокаИсправлениеВВетках.ВеткаИсправления) Тогда
					СтрокаИсправлениеВВетках.ВеткаИсправления = Ветка;
				КонецЕсли;
			КонецЦикла;
			ОшибкаОбъект.Записать();
			КоличествоУспешных = КоличествоУспешных + 1;
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Не удалось указать ветку исправления ""%1"" в ошибке %2.'"), Ветка, Ошибка.Код);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#Область ОтборыСпискаОшибок

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоСтатусу()
	
	Если ВариантОтбораПоСтатусуСпискаОшибок = 0 Тогда
		// Все, т.е. без отбора
		ВсеСтатусы = Новый СписокЗначений;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Статус",
																			ВсеСтатусы,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Ложь);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибок = 1 Тогда
		// В работе
		СтатусыВРаботе = Новый СписокЗначений;
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.НеЗарегистрирована);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Зарегистрирована);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Признана);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.НеПризнана);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Исправлена);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Статус",
																			СтатусыВРаботе,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Истина);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибок = 2 Тогда
		// Исправленные
		СтатусыИсправлена = Новый СписокЗначений;
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.Исправлена);
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.ПроверенаИсправлена);
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.Закрыта);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Статус",
																			СтатусыИсправлена,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Истина);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Исправлена",
																			Истина,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Истина);
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибок = 3 Тогда
		// Иное
		ИспользоватьОтбор = СписокОтбораПоСтатусамСпискаОшибок.Количество()>0;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			    "Статус",
		                                                                        СписокОтбораПоСтатусамСпискаОшибок,
																				ВидСравненияКомпоновкиДанных.ВСписке,
																				,
																				ИспользоватьОтбор);
																				
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	КонецЕсли;
																		
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоСрочностиИсправления()
	
	СписокСрочностьИсправления = Новый СписокЗначений;
	
	Если СрочностьНемедленноДляСпискаОшибок Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.Немедленно);
	КонецЕсли;
	
	Если СрочностьЖелательноБыстрееДляСпискаОшибок Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.ЖелательноБыстрее);
	КонецЕсли;
	
	Если СрочностьВПлановомПорядкеДляСпискаОшибок Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.ВПлановомПорядке);
	КонецЕсли;
	
	ИспользоватьОтбор = СписокСрочностьИсправления.Количество()>0;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"СрочностьИсправления",
																			СписокСрочностьИсправления,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			ИспользоватьОтбор);
	
КонецПроцедуры
																		
&НаСервере
Процедура УстановитьОтборСпискаОшибокПоВерсииИсправления()
	
	СписокВерсий = Новый СписокЗначений;
	Для Каждого ЭлементСписка из СписокВерсийИсправленияДляСпискаОшибок Цикл
		Если ЭлементСписка.Пометка Тогда
			СписокВерсий.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"ВерсияИсправления",
																			СписокВерсий,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			СписокВерсий.Количество()>0);
	
КонецПроцедуры																		

&НаСервере
Процедура ПриИзмененииВариантаОтбораСпискаОшибокПоСтатусу()

	УстановитьДоступностьЭлементовОтбораСпискаОшибокПоСтатусу();
	УстановитьОтборСпискаОшибокПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВариантаОтбораСпискаОшибокПоСтатусуИное()

	УстановитьДоступностьЭлементовОтбораСпискаОшибокПоСтатусу();
	УстановитьОтборСпискаОшибокПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоКомуНаправленаПользователь()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"КомуНаправлена",
																			НаправленаПользовательСпискаОшибок,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(НаправленаПользовательСпискаОшибок));
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоКомуНаправленаПодразделение()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"ПодразделениеКомуНаправлена",
																			НаправленаПодразделениеСпискаОшибок,
																			ВидСравненияКомпоновкиДанных.ВИерархии,
																			,
																			ЗначениеЗаполнено(НаправленаПодразделениеСпискаОшибок));
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоМестуОбнаружения()
	
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
																			НСтр("ru='Отбор по месту обнаружения'"),
																			ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ);
																			
	ГруппаИЛИ.Использование = ОбнаруженаВСборкахДляСпискаОшибок
	                          ИЛИ ОбнаруженаВОсновнойВеткеДляСпискаОшибок
							  ИЛИ ОбнаруженаВВеткахВерсийДляСпискаОшибок
							  ИЛИ ОбнаруженаВПрочихВеткахДляСпискаОшибок;
																			
	СписокМестОбнаружения = Новый СписокЗначений;
	
	Если ОбнаруженаВСборкахДляСпискаОшибок Тогда
		СписокМестОбнаружения.Добавить(Перечисления.МестаОбнаруженияОшибок.ВСборке);
	КонецЕсли;
	
	Если ОбнаруженаВОсновнойВеткеДляСпискаОшибок
		ИЛИ ОбнаруженаВВеткахВерсийДляСпискаОшибок
		ИЛИ ОбнаруженаВПрочихВеткахДляСпискаОшибок Тогда
		СписокМестОбнаружения.Добавить(Перечисления.МестаОбнаруженияОшибок.ВВетке);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			"МестоОбнаружения",
																			СписокМестОбнаружения,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			СписокМестОбнаружения.Количество()>0);
																			
	ТипыВетокОбнаружения = Новый СписокЗначений;
	
	Если ОбнаруженаВОсновнойВеткеДляСпискаОшибок Тогда
		ТипыВетокОбнаружения.Добавить(Перечисления.ТипыВеток.ОсновнаяВеткаПроекта);
	КонецЕсли;
	
	Если ОбнаруженаВВеткахВерсийДляСпискаОшибок Тогда
		ТипыВетокОбнаружения.Добавить(Перечисления.ТипыВеток.ВеткаВерсии);
	КонецЕсли;
	
	Если ОбнаруженаВПрочихВеткахДляСпискаОшибок Тогда
		ТипыВетокОбнаружения.Добавить(Перечисления.ТипыВеток.ВеткаДляИсправленияОшибок);
		ТипыВетокОбнаружения.Добавить(Перечисления.ТипыВеток.ВеткаТехническогоПроекта);
	КонецЕсли;
																			
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
	                                                       "МестоОбнаружения",
	                                                       ВидСравненияКомпоновкиДанных.Равно,
														   Перечисления.МестаОбнаруженияОшибок.ВСборке,
														   ,
														   ОбнаруженаВСборкахДляСпискаОшибок);
														   
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
	                                                       "ТипВеткиОбнаружения",
	                                                       ВидСравненияКомпоновкиДанных.ВСписке,
														   ТипыВетокОбнаружения,
														   ,
														   ТипыВетокОбнаружения.Количество()>0);
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоИсточнику()
	
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы,
																			НСтр("ru='Отбор по источнику'"),
																			ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ);
																			
	ГруппаИЛИ.Использование = ИсточникВнешнийСпискаОшибок
	                          ИЛИ ИсточникРучноеТестированиеСпискаОшибок
							  ИЛИ ИсточникАвтотестыСпискаОшибок;
							  
	ГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаИЛИ,
																		НСтр("ru='Отбор по методу выявления'"),
																		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
																			
	ГруппаИ.Использование = ИсточникРучноеТестированиеСпискаОшибок
							ИЛИ ИсточникАвтотестыСпискаОшибок;
							
	СписокМетодовВыявления = Новый СписокЗначений;
	
	Если ИсточникРучноеТестированиеСпискаОшибок Тогда
		СписокМетодовВыявления.Добавить(Перечисления.МетодыВыявленияОшибок.АудитКода);
		СписокМетодовВыявления.Добавить(Перечисления.МетодыВыявленияОшибок.РаботаСПрограммой);
	КонецЕсли;
	
	Если ИсточникАвтотестыСпискаОшибок Тогда
		СписокМетодовВыявления.Добавить(Перечисления.МетодыВыявленияОшибок.Автотесты);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
	                                                       "МетодВыявленияОшибки",
	                                                       ВидСравненияКомпоновкиДанных.ВСписке,
														   СписокМетодовВыявления,
														   ,
														   СписокМетодовВыявления.Количество()>0);
														   
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
	                                                       "ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников",
	                                                       ВидСравненияКомпоновкиДанных.Равно,
														   Ложь,
														   ,
														   СписокМетодовВыявления.Количество()>0);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
	                                                       "ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников",
	                                                       ВидСравненияКомпоновкиДанных.Равно,
														   Истина,
														   ,
														   ИсточникВнешнийСпискаОшибок);
	
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоОтработал(ЗначениеКтоОтработал, ПостфиксПоляДействия="")
	
	Если ПостфиксПоляДействия = "Подразделение" Тогда
		ВидСравненияОтработал = ВидСравненияКОмпоновкиДанных.ВИерархии;
	Иначе
		ВидСравненияОтработал = ВидСравненияКОмпоновкиДанных.Равно;
	КонецЕсли;
	
	СписокДействийОтработал = СписокОтбораОтработал();
	
	Для Каждого Действие из СписокДействийОтработал Цикл
		
		ИспользоватьОтборПоДействию = Ложь;
		
		Если ЗначениеЗаполнено(ЗначениеКтоОтработал) Тогда
			ЭлементСпискаОтбора = СписокОтбораОтработалСпискаОшибок.НайтиПоЗначению(Действие);
			Если ЭлементСпискаОтбора <> Неопределено Тогда
				ИспользоватьОтборПоДействию = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ПолеОтбора = Действие + ПостфиксПоляДействия;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
																			ПолеОтбора,
																			ЗначениеКтоОтработал,
																			ВидСравненияОтработал,
																			,
																			ИспользоватьОтборПоДействию);
																			
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененнииОтбораСпискаОшибокОтработал()

	УстановитьОтборСпискаОшибокПоОтработал(ОтработалПодразделениеСпискаОшибок, "Подразделение");
	УстановитьОтборСпискаОшибокПоОтработал(ОтработалПользовательСпискаОшибок);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовОтбораСпискаОшибокПоСтатусу()
	
	Элементы.СписокОтбораПоСтатусамСпискаОшибок.Доступность = (ВариантОтбораПоСтатусуСпискаОшибок=3);
	
КонецПроцедуры

