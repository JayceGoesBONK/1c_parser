#КонецОбласти

&НаСервере
Функция СписокОтбораОтработал()

	СписокДействий = Новый Массив;
	
	СписокДействий.Добавить("Автор");
	СписокДействий.Добавить("Зарегистрировал");
	СписокДействий.Добавить("Рассмотрел");
	СписокДействий.Добавить("Исправил");
	СписокДействий.Добавить("Проверил");
	СписокДействий.Добавить("Отозвал");
	СписокДействий.Добавить("Закрыл");
	СписокДействий.Добавить("НеПланируетИсправлять");
	СписокДействий.Добавить("УстановилОжидаетИсправленияПовторяемой");
	
	Возврат СписокДействий;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыВыбораСпискаВерсийИсправленияСпискаОшибок(Проект)

	ПараметрыВыбораДляПоля = Новый Массив;
	
	Если ЗначениеЗаполнено(Проект) Тогда
		ПараметрВыбораПоПроекту = Новый ПараметрВыбора("Отбор.Владелец", Проект);
		ПараметрыВыбораДляПоля.Добавить(ПараметрВыбораПоПроекту);
	КонецЕсли;
		
	УстанавливаемыеПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораДляПоля);
	Элементы.СписокВерсийИсправленияДляСпискаОшибокЗначение.ПараметрыВыбора = УстанавливаемыеПараметрыВыбора;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСпискаРелизныхВетокСпискаОшибокВВетках(Проект)
	
	НовыеПараметрыВыбора = Новый Массив;
	
	ТекущиеПараметрыВыбора = Элементы.СписокОтбораПоРелизнымВеткамСпискаОшибокВВеткахЗначение.ПараметрыВыбора;
	
	Для Каждого ТекущийПараметрВыбора из ТекущиеПараметрыВыбора Цикл
		Если ТекущийПараметрВыбора.Имя <> "Отбор.Владелец" Тогда
			НовыеПараметрыВыбора.Добавить(ТекущийПараметрВыбора);
		КонецЕсли;
	КонецЦикла;
			
	Если ЗначениеЗаполнено(Проект) Тогда
		ПараметрВыбораПоПроекту = Новый ПараметрВыбора("Отбор.Владелец", Проект);
		НовыеПараметрыВыбора.Добавить(ПараметрВыбораПоПроекту);
	КонецЕсли;
			
	УстанавливаемыеПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
	Элементы.СписокОтбораПоРелизнымВеткамСпискаОшибокВВеткахЗначение.ПараметрыВыбора = УстанавливаемыеПараметрыВыбора;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАктуальныеВеткиДляОтбораСпискаОшибокВВеткахЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		ПодобратьАктуальныеВеткиПроектовУстановитьОтборОшибокВВетках(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьАктуальныеВеткиПроектовУстановитьОтборОшибокВВетках(ВыбранныеПроекты)

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ветки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Ветки КАК Ветки
	|ГДЕ
	|	Ветки.Владелец В(&Проекты)
	|	И НЕ Ветки.ПометкаУдаления
	|	И Ветки.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыВеток.ОсновнаяВеткаПроекта), ЗНАЧЕНИЕ(Перечисление.ТипыВеток.ВеткаВерсии))
	|	И Ветки.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыВеток.Заморожена)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ветки.Владелец"
	;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Проекты", ВыбранныеПроекты);
	
	АктуальныеВетки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	СписокОтбораПоРелизнымВеткамСпискаОшибокВВетках.ЗагрузитьЗначения(АктуальныеВетки);
	СписокОтбораПоРелизнымВеткамСпискаОшибокВВетках.ЗаполнитьПометки(Истина);
	
	УстановитьОтборСпискаОшибокВВеткахПоРелизнымВеткам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАктуальныеВерсииИсправленияДляОтбораСпискаОшибокЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		ПодобратьАктуальныеВерсииПроектовУстановитьОтборОшибокВВетках(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьАктуальныеВерсииПроектовУстановитьОтборОшибокВВетках(ВыбранныеПроекты)

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Версии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВерсииПроекта КАК Версии
	|ГДЕ
	|	Версии.Владелец В(&Проекты)
	|	И НЕ Версии.ПометкаУдаления
	|	И (Версии.ДатаПрекращенияПоддержки = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Версии.ДатаПрекращенияПоддержки > &ТекущаяДата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версии.Владелец,
	|	Версии.ПорядковыйНомер"
	;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Проекты", ВыбранныеПроекты);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	АктуальныеВерсии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	СписокВерсийИсправленияДляСпискаОшибок.ЗагрузитьЗначения(АктуальныеВерсии);
	СписокВерсийИсправленияДляСпискаОшибок.ЗаполнитьПометки(Истина);
	
	УстановитьОтборСпискаОшибокПоВерсииИсправления();
	
КонецПроцедуры

#КонецОбласти
