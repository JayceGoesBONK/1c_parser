#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступноИзменениеОшибок = РольДоступна("ДобавлениеИзменениеОшибок")
	                          ИЛИ РольДоступна("ПолныеПрава");
							  
	ДоступноПланированиеОтработки = РольДоступна("ПланированиеОтработкиОшибок")
	                          ИЛИ РольДоступна("ПолныеПрава");
	
	Если Параметры.КлючНазначенияИспользования = "ПодборДляТехническихПроектов" 
		ИЛИ Параметры.Свойство("РежимВыбора") И Параметры.РежимВыбора Тогда
		Элементы.Список.РежимВыбора = Истина;
	Иначе
		Проект = ПараметрыСеанса.ТекущийПроект;
		
		УстановитьПараметрыВыбораСпискаВерсийИсправленияСпискаОшибок(Проект);
		УстановитьПараметрыВыбораСпискаРелизныхВетокСпискаОшибокВВетках(Проект);
		
		Проекты.УстановитьОтборВСпискеПоПроекту(Список, Проект);
		Проекты.УстановитьОтборВСпискеПоПроекту(СписокОшибокВВетках, Проект);
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	УстановитьДоступностьЭлементовОтбораСпискаОшибокПоСтатусу();
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтаФорма, Элементы.СписокКомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ОбъектыНаКонтроле
	СпискиДляВыводаКомандКонтроля = Новый Массив;
	СпискиДляВыводаКомандКонтроля.Добавить(
		ОбъектыНаКонтроле.ДанныеСпискаДляВыводаКомандКонтроля(
		"Список", "СписокГруппаКонтроль", "СписокКонтекстноеМенюГруппаКонтроль"));
	ОбъектыНаКонтроле.НастроитьЭлементыПоставитьНаКонтрольВФормеСписка(ЭтотОбъект, СпискиДляВыводаКомандКонтроля);
	// Конец ОбъектыНаКонтроле
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	// Отборы списка ошибок
	ПриИзмененииВариантаОтбораСпискаОшибокПоСтатусу();
	УстановитьОтборСпискаОшибокПоСрочностиИсправления();
	УстановитьОтборСпискаОшибокПоВерсииИсправления();
	УстановитьОтборСпискаОшибокПоКомуНаправленаПользователь();
	УстановитьОтборСпискаОшибокПоКомуНаправленаПодразделение();
	УстановитьОтборСпискаОшибокПоМестуОбнаружения();
	УстановитьОтборСпискаОшибокПоИсточнику();
	УстановитьОтборСпискаОшибокПоОтработал(ОтработалПодразделениеСпискаОшибок, "Подразделение");
	УстановитьОтборСпискаОшибокПоОтработал(ОтработалПользовательСпискаОшибок);
	
	// Отборы списка ошибок в ветках
	ПриИзмененииВариантаОтбораСпискаОшибокВВеткахПоСтатусу();
	УстановитьОтборСпискаОшибокВВеткахПоСрочностиИсправления();
	УстановитьОтборСпискаОшибокВВеткахПоРелизнымВеткам();
	УстановитьОтборСпискаОшибокВВеткахПоСтатусуВеткиИсправления();
	УстановитьОтборСпискаОшибокПоСостояниюИсправления();
	УстановитьОтборСпискаОшибокВВеткахПоПодразделениюОтветственномуЗаВеткуИсправления();
	УстановитьОтборСпискаОшибокВВеткахПоОтветственномуЗаВеткуИсправления();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененТекущийПроект" Тогда
		УстановитьОтборПоПроектуСервер();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

