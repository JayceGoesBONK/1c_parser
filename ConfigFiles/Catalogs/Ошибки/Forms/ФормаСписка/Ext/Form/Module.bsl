&НаСервере
Процедура ПриИзмененииВариантаОтбораСпискаОшибокВВеткахПоСтатусу()

	УстановитьДоступностьЭлементовОтбораСпискаОшибокВВеткахПоСтатусу();
	УстановитьОтборСпискаОшибокВВеткахПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокВВеткахПоСтатусу()
	
	Если ВариантОтбораПоСтатусуСпискаОшибокВВетках = 0 Тогда
		// Все, т.е. без отбора
		ВсеСтатусы = Новый СписокЗначений;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Статус",
																			ВсеСтатусы,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Ложь);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибокВВетках = 1 Тогда
		// В работе
		СтатусыВРаботе = Новый СписокЗначений;
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.НеЗарегистрирована);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Зарегистрирована);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Признана);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.НеПризнана);
		СтатусыВРаботе.Добавить(Перечисления.СтатусыОшибок.Исправлена);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Статус",
																			СтатусыВРаботе,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Истина);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибокВВетках = 2 Тогда
		// Исправленные
		СтатусыИсправлена = Новый СписокЗначений;
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.Исправлена);
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.ПроверенаИсправлена);
		СтатусыИсправлена.Добавить(Перечисления.СтатусыОшибок.Закрыта);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Статус",
																			СтатусыИсправлена,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			Истина);
																			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Исправлена",
																			Истина,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Истина);
	ИначеЕсли ВариантОтбораПоСтатусуСпискаОшибокВВетках = 3 Тогда
		// Иное
		ИспользоватьОтбор = СписокОтбораПоСтатусамСпискаОшибокВВетках.Количество()>0;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			    "Статус",
		                                                                        СписокОтбораПоСтатусамСпискаОшибокВВетках,
																				ВидСравненияКомпоновкиДанных.ВСписке,
																				,
																				ИспользоватьОтбор);
																				
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Исправлена",
																			Ложь,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			Ложь);
																			
	КонецЕсли;
																		
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокВВеткахПоСрочностиИсправления()
	
	СписокСрочностьИсправления = Новый СписокЗначений;
	
	Если СрочностьНемедленноДляСпискаОшибокВВетках Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.Немедленно);
	КонецЕсли;
	
	Если СрочностьЖелательноБыстрееДляСпискаОшибокВВетках Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.ЖелательноБыстрее);
	КонецЕсли;
	
	Если СрочностьВПлановомПорядкеДляСпискаОшибокВВетках Тогда
		СписокСрочностьИсправления.Добавить(Перечисления.СрочностьИсправленияОшибок.ВПлановомПорядке);
	КонецЕсли;
	
	ИспользоватьОтбор = СписокСрочностьИсправления.Количество()>0;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"СрочностьИсправления",
																			СписокСрочностьИсправления,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			ИспользоватьОтбор);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокВВеткахПоРелизнымВеткам()

	СписокВеток = Новый СписокЗначений;
	Для Каждого ЭлементСписка из СписокОтбораПоРелизнымВеткамСпискаОшибокВВетках Цикл
		Если ЭлементСписка.Пометка И ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			СписокВеток.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"Ветка",
																			СписокВеток,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			СписокВеток.Количество()>0);
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокВВеткахПоСтатусуВеткиИсправления()

	СписокСтатусовВеток = Новый СписокЗначений;
	
	Если ИсправительнаяВеткаСпискаОшибокВВеткахРазрабатывается Тогда
		СписокСтатусовВеток.Добавить(Перечисления.СтатусыВеток.Разрабатывается);
	КонецЕсли;
	
	Если ИсправительнаяВеткаСпискаОшибокВВеткахТестируется Тогда
		СписокСтатусовВеток.Добавить(Перечисления.СтатусыВеток.Тестируется);
	КонецЕсли;
	
	Если ИсправительнаяВеткаСпискаОшибокВВеткахЗаморожена Тогда
		СписокСтатусовВеток.Добавить(Перечисления.СтатусыВеток.Заморожена);
	КонецЕсли;
	
	Если ИсправительнаяВеткаСпискаОшибокВВеткахПомещена Тогда
		СписокСтатусовВеток.Добавить(Перечисления.СтатусыВеток.Помещена);
	КонецЕсли;
	
	Если ИсправительнаяВеткаСпискаОшибокВВеткахНеУказана Тогда
		СписокСтатусовВеток.Добавить(Перечисления.СтатусыВеток.ПустаяСсылка());
	КонецЕсли;
	
	ИспользоватьОтбор = СписокСтатусовВеток.Количество()>0;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"СтатусВеткиИсправления",
																			СписокСтатусовВеток,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			ИспользоватьОтбор);
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокПоСостояниюИсправления()

	СписокСостояний = Новый СписокЗначений;
	
	Если СостояниеВВеткеТребуетсяИсправление Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияИсправленияОшибок.ТребуетсяИсправление);
	КонецЕсли;
	
	Если СостояниеВВеткеИсправлена Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияИсправленияОшибок.Исправлена);
	КонецЕсли;
	
	Если СостояниеВВеткеНеПланируетсяИсправлять Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияИсправленияОшибок.ИсправлениеНеПланируется);
	КонецЕсли;
	
	Если СостояниеВВеткеОшибкиНеБылоВЭтойВетке Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияИсправленияОшибок.ОшибкиНеБылоВЭтойВетке);
	КонецЕсли;
	
	Если СостояниеВВеткеИсправляетсяВОтдельнойОШибке Тогда
		СписокСостояний.Добавить(Перечисления.СостоянияИсправленияОшибок.ИсправляетсяВОтдельнойОшибке);
	КонецЕсли;
	
	ИспользоватьОтбор = СписокСостояний.Количество()>0;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
																			"СостояниеИсправления",
																			СписокСостояний,
																			ВидСравненияКомпоновкиДанных.ВСписке,
																			,
																			ИспользоватьОтбор);
																			
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСпискаОшибокВВеткахПоПодразделениюОтветственномуЗаВеткуИсправления()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокОшибокВВетках,
